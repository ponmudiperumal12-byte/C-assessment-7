#include <stdio.h>

void disp_hcf_3digit(int a, int b, int c)
{
    int i, hcf = 1;

    for(i = 1; i <= a && i <= b && i <= c; i++)
    {
        if(a % i == 0 && b % i == 0 && c % i == 0)
            hcf = i;
    }

    printf("%d", hcf);
}

int main()
{
    int a, b, c;
   printf("enter the number:) ;
    scanf("%d%d%d", &a, &b, &c);

    disp_hcf_3digit(a, b, c);


}
